# Copy to .env and edit. Never commit .env
DATABASE_URL=postgresql+psycopg2://soil:soil@localhost:5432/soildb
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Farmer Authentication & Security
JWT_SECRET_KEY=your-secure-random-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
